# Application
APP_NAME="AMU Student Resource Management System"
APP_ENV="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# PostgreSQL Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="amu_user"
POSTGRES_PASSWORD="amu_password_secure"
POSTGRES_DB="amu_resources_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# S3 / MinIO Object Storage
S3_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET_NAME="academic-resources"
S3_REGION="us-east-1"

# JWT Authentication
JWT_SECRET_KEY="replace_with_secure_random_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage Quota Policies (in bytes)
STUDENT_DEFAULT_QUOTA_BYTES=1073741824
TEACHER_DEFAULT_QUOTA_BYTES=16106127360
UPLOAD_RESERVATION_TIMEOUT_MINUTES=30

# OpenTelemetry / PostHog Logging
OTEL_ENABLED=true
OTEL_SERVICE_NAME="my-app"
POSTHOG_LOGS_ENDPOINT="https://us.i.posthog.com/i/v1/logs"
POSTHOG_API_KEY="replace_with_posthog_personal_or_project_api_key"

# Email / SMTP Configuration
EMAIL_HOST_USER="user@example.com"
EMAIL_HOST_PASSWORD="replace_with_app_password"
EMAIL_SERVER="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USE_TLS=true
MAIL_FROM="user@example.com"
MAIL_FROM_NAME="AMU Support"
FRONTEND_URL="http://localhost:3000"

# Supabase Storage Configuration
SUPABASE_URL="https://your-project.storage.supabase.co"
SUPABASE_KEY="replace_with_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="replace_with_supabase_service_role_key_for_backend_uploads"
SUPABASE_BUCKET="resources"
SUPABASE_REGION="ap-southeast-2"
SUPABASE_WEBHOOK_SECRET="replace_with_webhook_secret"

